{
  "name": "glib-glub-monorepo",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "db:migrate": "pnpm --filter @glib-glub/db migrate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@campfhir/safe-functions": "^0.1.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix --no-warn-ignored"
  }
}
