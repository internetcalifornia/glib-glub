# Copy to .env and fill in. Every variable is read exactly once, in
# packages/config/src/env.ts, and validated at startup.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/glib_glub

# --- Web app ----------------------------------------------------------------
# Public origin of the web app. Better Auth uses it as the OAuth callback base
# and passkeys use its host as the relying-party id.
APP_ORIGIN=http://localhost:3000
# 32+ random bytes, base64. `openssl rand -base64 32`
AUTH_SECRET=

# Social login credentials. Leave a pair empty to disable that provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Voice gateway ----------------------------------------------------------
VOICE_GATEWAY_PORT=8787
# Public URL the browser connects to for signalling.
VOICE_GATEWAY_URL=ws://localhost:8787
# Set to 1 to use the in-process fake Voice Live server instead of Azure.
VOICE_LIVE_FAKE=

# --- Azure AI Foundry -------------------------------------------------------
# https://<resource>.services.ai.azure.com
AZURE_FOUNDRY_ENDPOINT=
# API key, or leave empty to use Microsoft Entra (DefaultAzureCredential).
AZURE_FOUNDRY_API_KEY=
# Voice Live model for the tutor. gpt-realtime (pro) or gpt-realtime-mini (basic).
VOICE_LIVE_MODEL=gpt-realtime
VOICE_LIVE_API_VERSION=2026-04-10
# Chat deployment used for grading, summaries and extraction.
AZURE_CHAT_DEPLOYMENT=gpt-4.1-mini

# --- Blob storage -----------------------------------------------------------
# Azurite locally; a real account in production. Leave empty to store uploads
# on local disk under .blobs/ (development only).
AZURE_STORAGE_CONNECTION_STRING=
BLOB_CONTAINER=uploads

# --- Logging ----------------------------------------------------------------
CONSOLE_LOG_LEVEL=info
LOG_DB_LEVEL=info
